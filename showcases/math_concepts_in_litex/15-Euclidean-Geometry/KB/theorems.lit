#     u[1] * (v[2] + w[2]) - u[2] * (v[1] + w[1]) = (u[1] * v[2] - u[2] * v[1]) + (u[1] * w[2] - u[2] * w[1])
#     KB::definitions::det(u, (v[1] + w[1], v[2] + w[2])) = KB::definitions::det(u, v) + KB::definitions::det(u, w)

thm concyclic_det_criterion:
    ? forall a, b, c, d cart(R, R):
        (a[1] - d[1]) * (b[2] - d[2]) - (a[2] - d[2]) * (b[1] - d[1]) != 0,
        ((a[1] - d[1])^2 + (a[2] - d[2])^2) * ((b[1] - d[1]) * (c[2] - d[2]) - (b[2] - d[2]) * (c[1] - d[1])) - ((b[1] - d[1])^2 + (b[2] - d[2])^2) * ((a[1] - d[1]) * (c[2] - d[2]) - (a[2] - d[2]) * (c[1] - d[1])) + ((c[1] - d[1])^2 + (c[2] - d[2])^2) * ((a[1] - d[1]) * (b[2] - d[2]) - (a[2] - d[2]) * (b[1] - d[1])) = 0
        =>:
            KB::definitions::distance_sq(a, d) * KB::definitions::det(KB::definitions::vec(d, b), KB::definitions::vec(d, c)) - KB::definitions::distance_sq(b, d) * KB::definitions::det(KB::definitions::vec(d, a), KB::definitions::vec(d, c)) + KB::definitions::distance_sq(c, d) * KB::definitions::det(KB::definitions::vec(d, a), KB::definitions::vec(d, b)) = 0
    KB::definitions::distance_sq(a, d) = (d[1] - a[1])^2 + (d[2] - a[2])^2
    KB::definitions::distance_sq(b, d) = (d[1] - b[1])^2 + (d[2] - b[2])^2
    KB::definitions::distance_sq(c, d) = (d[1] - c[1])^2 + (d[2] - c[2])^2
    (d[1] - a[1])^2 = (a[1] - d[1])^2
    (d[2] - a[2])^2 = (a[2] - d[2])^2
    (d[1] - b[1])^2 = (b[1] - d[1])^2
    (d[2] - b[2])^2 = (b[2] - d[2])^2
    (d[1] - c[1])^2 = (c[1] - d[1])^2
    (d[2] - c[2])^2 = (c[2] - d[2])^2
    KB::definitions::vec(d, a) = (a[1] - d[1], a[2] - d[2])
    KB::definitions::vec(d, b) = (b[1] - d[1], b[2] - d[2])
    KB::definitions::vec(d, c) = (c[1] - d[1], c[2] - d[2])
    KB::definitions::det(KB::definitions::vec(d, a), KB::definitions::vec(d, b)) = (a[1] - d[1]) * (b[2] - d[2]) - (a[2] - d[2]) * (b[1] - d[1])
    KB::definitions::det(KB::definitions::vec(d, a), KB::definitions::vec(d, c)) = (a[1] - d[1]) * (c[2] - d[2]) - (a[2] - d[2]) * (c[1] - d[1])
    KB::definitions::det(KB::definitions::vec(d, b), KB::definitions::vec(d, c)) = (b[1] - d[1]) * (c[2] - d[2]) - (b[2] - d[2]) * (c[1] - d[1])
    KB::definitions::distance_sq(a, d) * KB::definitions::det(KB::definitions::vec(d, b), KB::definitions::vec(d, c)) - KB::definitions::distance_sq(b, d) * KB::definitions::det(KB::definitions::vec(d, a), KB::definitions::vec(d, c)) + KB::definitions::distance_sq(c, d) * KB::definitions::det(KB::definitions::vec(d, a), KB::definitions::vec(d, b)) = ((a[1] - d[1])^2 + (a[2] - d[2])^2) * ((b[1] - d[1]) * (c[2] - d[2]) - (b[2] - d[2]) * (c[1] - d[1])) - ((b[1] - d[1])^2 + (b[2] - d[2])^2) * ((a[1] - d[1]) * (c[2] - d[2]) - (a[2] - d[2]) * (c[1] - d[1])) + ((c[1] - d[1])^2 + (c[2] - d[2])^2) * ((a[1] - d[1]) * (b[2] - d[2]) - (a[2] - d[2]) * (b[1] - d[1]))
    KB::definitions::distance_sq(a, d) * KB::definitions::det(KB::definitions::vec(d, b), KB::definitions::vec(d, c)) - KB::definitions::distance_sq(b, d) * KB::definitions::det(KB::definitions::vec(d, a), KB::definitions::vec(d, c)) + KB::definitions::distance_sq(c, d) * KB::definitions::det(KB::definitions::vec(d, a), KB::definitions::vec(d, b)) = 0

