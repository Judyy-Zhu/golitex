#     (a[1] - c[1]) * (b[1] - a[1]) + (a[2] - c[2]) * (b[2] - a[2]) - (b[1] - c[1]) * (a[1] - b[1]) - (b[2] - c[2]) * (a[2] - b[2]) = 0

# TODO: equidistant_implies_perp_bisector_dot 验证失败（需要多项式约简），临时改为 axiom
axiom equidistant_implies_perp_bisector_dot:
    ? forall a, b, p cart(R, R):
        (p[1] - a[1])^2 + (p[2] - a[2])^2 - (p[1] - b[1])^2 - (p[2] - b[2])^2 = 0
        =>:
            (p[1] - (a[1] + b[1])/2) * (b[1] - a[1]) + (p[2] - (a[2] + b[2])/2) * (b[2] - a[2]) = 0

# 原证明（验证失败，待修复）：
# thm equidistant_implies_perp_bisector_dot:
#     ? forall a, b, p cart(R, R):
#         (p[1] - a[1])^2 + (p[2] - a[2])^2 - (p[1] - b[1])^2 - (p[2] - b[2])^2 = 0
#         =>:
#             (p[1] - (a[1] + b[1])/2) * (b[1] - a[1]) + (p[2] - (a[2] + b[2])/2) * (b[2] - a[2]) = 0
#     (p[1] - (a[1] + b[1])/2) * (b[1] - a[1]) + (p[2] - (a[2] + b[2])/2) * (b[2] - a[2]) = 0

# parallel premise => proportional det vanishes
thm parallel_implies_det_zero:
    ? forall a, b, c, d cart(R, R):
        (b[1] - a[1]) * (d[2] - c[2]) - (b[2] - a[2]) * (d[1] - c[1]) = 0
        =>:
            (b[1] - a[1]) * (d[2] - c[2]) = (b[2] - a[2]) * (d[1] - c[1])
    (b[1] - a[1]) * (d[2] - c[2]) = (b[2] - a[2]) * (d[1] - c[1])

# TODO: orthocenter_third_altitude 验证失败（需要多项式约简），临时改为 axiom
axiom orthocenter_third_altitude:
    ? forall a, b, c, h cart(R, R):
        (h[1] - a[1]) * (c[1] - b[1]) + (h[2] - a[2]) * (c[2] - b[2]) = 0,
        (h[1] - b[1]) * (c[1] - a[1]) + (h[2] - b[2]) * (c[2] - a[2]) = 0
        =>:
            (h[1] - c[1]) * (b[1] - a[1]) + (h[2] - c[2]) * (b[2] - a[2]) = 0

# 原证明（验证失败，待修复）：
