#     KB::definitions::distance_sq(a, p) = (2 * t)^2 * KB::definitions::distance_sq(a, m)

thm inner_product_distance_identity:
    ? forall a, b, c, d cart(R, R):
        2 * KB::definitions::dot(KB::definitions::vec(a, b), KB::definitions::vec(c, d)) = KB::definitions::distance_sq(a, d) + KB::definitions::distance_sq(b, c) - KB::definitions::distance_sq(a, c) - KB::definitions::distance_sq(b, d)
    KB::definitions::vec(a, b) = (b[1] - a[1], b[2] - a[2])
    KB::definitions::vec(c, d) = (d[1] - c[1], d[2] - c[2])
    KB::definitions::dot(KB::definitions::vec(a, b), KB::definitions::vec(c, d)) = (b[1] - a[1]) * (d[1] - c[1]) + (b[2] - a[2]) * (d[2] - c[2])
    KB::definitions::distance_sq(a, d) = (d[1] - a[1])^2 + (d[2] - a[2])^2
    KB::definitions::distance_sq(b, c) = (c[1] - b[1])^2 + (c[2] - b[2])^2
    KB::definitions::distance_sq(a, c) = (c[1] - a[1])^2 + (c[2] - a[2])^2
    KB::definitions::distance_sq(b, d) = (d[1] - b[1])^2 + (d[2] - b[2])^2
    2 * ((b[1] - a[1]) * (d[1] - c[1]) + (b[2] - a[2]) * (d[2] - c[2])) = (d[1] - a[1])^2 + (d[2] - a[2])^2 + ((c[1] - b[1])^2 + (c[2] - b[2])^2) - ((c[1] - a[1])^2 + (c[2] - a[2])^2) - ((d[1] - b[1])^2 + (d[2] - b[2])^2)
    2 * KB::definitions::dot(KB::definitions::vec(a, b), KB::definitions::vec(c, d)) = 2 * ((b[1] - a[1]) * (d[1] - c[1]) + (b[2] - a[2]) * (d[2] - c[2]))
    KB::definitions::distance_sq(a, d) + KB::definitions::distance_sq(b, c) - KB::definitions::distance_sq(a, c) - KB::definitions::distance_sq(b, d) = (d[1] - a[1])^2 + (d[2] - a[2])^2 + ((c[1] - b[1])^2 + (c[2] - b[2])^2) - ((c[1] - a[1])^2 + (c[2] - a[2])^2) - ((d[1] - b[1])^2 + (d[2] - b[2])^2)
    2 * KB::definitions::dot(KB::definitions::vec(a, b), KB::definitions::vec(c, d)) = KB::definitions::distance_sq(a, d) + KB::definitions::distance_sq(b, c) - KB::definitions::distance_sq(a, c) - KB::definitions::distance_sq(b, d)

# TODO: similar_triangles_ratio 验证失败（代数推导问题），临时改为 axiom
axiom similar_triangles_ratio:
    ? forall p, q, r, u, v, w cart(R, R), k R:
        u[1] - v[1] = k * (p[1] - q[1]),
        u[2] - v[2] = k * (p[2] - q[2]),
        w[1] - v[1] = k * (r[1] - q[1]),
        w[2] - v[2] = k * (r[2] - q[2])
        =>:
            KB::definitions::distance_sq(u, w) = k^2 * KB::definitions::distance_sq(p, r)

