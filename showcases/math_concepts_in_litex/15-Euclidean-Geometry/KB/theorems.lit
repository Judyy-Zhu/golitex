# Theorems and Axioms for Euclidean Geometry
# 
# This file contains theorems (thm) and axioms for geometric reasoning
# 
# Dependencies declared in litex.config: definitions.lit, predicates.lit

axiom addition_cancel:
    ? forall a, b, c R:
        a + c = b + c
        =>:
            a = b

axiom addition_cancel_left:
    ? forall a, b, c R:
        c + a = c + b
        =>:
            a = b

axiom subtraction_cancel:
    ? forall a, b, c R:
        a - c = b - c
        =>:
            a = b

axiom multiply_both_sides:
    ? forall a, b, c R:
        a = b
        =>:
            a * c = b * c

axiom divide_both_sides:
    ? forall a, b, c R:
        a * c = b * c,
        c != 0
        =>:
            a = b

axiom add_equalities:
    ? forall a, b, c, d R:
        a = b,
        c = d
        =>:
            a + c = b + d

axiom subtract_equalities:
    ? forall a, b, c, d R:
        a = b,
        c = d
        =>:
            a - c = b - d

# ═══════════════════════════════════════════════════════════════════════
# Layer 0: Coordinate formulas (pure polynomial identities)
# ═══════════════════════════════════════════════════════════════════════

thm distance_sq_coordinate_formula:
    ? forall a, b cart(R, R):
        KB::definitions::distance_sq(a, b) = (b[1] - a[1])^2 + (b[2] - a[2])^2
    KB::definitions::vec(a, b) = (b[1] - a[1], b[2] - a[2])
    KB::definitions::vec(a, b)[1] = b[1] - a[1]
    KB::definitions::vec(a, b)[2] = b[2] - a[2]
    KB::definitions::distance_sq(a, b) = KB::definitions::dot(KB::definitions::vec(a, b), KB::definitions::vec(a, b))
    KB::definitions::dot(KB::definitions::vec(a, b), KB::definitions::vec(a, b)) = KB::definitions::vec(a, b)[1] * KB::definitions::vec(a, b)[1] + KB::definitions::vec(a, b)[2] * KB::definitions::vec(a, b)[2] = (b[1] - a[1])^2 + (b[2] - a[2])^2

thm distance_sq_nonnegative:
    ? forall a, b cart(R, R):
        0 <= KB::definitions::distance_sq(a, b)
    0 <= (b[1] - a[1])^2
    0 <= (b[2] - a[2])^2
    0 <= (b[1] - a[1])^2 + (b[2] - a[2])^2
    KB::definitions::distance_sq(a, b) = (b[1] - a[1])^2 + (b[2] - a[2])^2
    0 <= KB::definitions::distance_sq(a, b)

thm distance_sq_symmetric:
    ? forall a, b cart(R, R):
        KB::definitions::distance_sq(a, b) = KB::definitions::distance_sq(b, a)
    KB::definitions::distance_sq(a, b) = (b[1] - a[1])^2 + (b[2] - a[2])^2
    KB::definitions::distance_sq(b, a) = (a[1] - b[1])^2 + (a[2] - b[2])^2
    (b[1] - a[1])^2 = (a[1] - b[1])^2
    (b[2] - a[2])^2 = (a[2] - b[2])^2
    (b[1] - a[1])^2 + (b[2] - a[2])^2 = (a[1] - b[1])^2 + (a[2] - b[2])^2
    KB::definitions::distance_sq(a, b) = (a[1] - b[1])^2 + (a[2] - b[2])^2
    KB::definitions::distance_sq(a, b) = KB::definitions::distance_sq(b, a)

thm vec_coordinate_formula:
    ? forall a, b cart(R, R):
        KB::definitions::vec(a, b) = (b[1] - a[1], b[2] - a[2])

thm dot_coordinate_formula:
    ? forall u, v cart(R, R):
        KB::definitions::dot(u, v) = u[1] * v[1] + u[2] * v[2]

thm det_coordinate_formula:
    ? forall u, v cart(R, R):
        KB::definitions::det(u, v) = u[1] * v[2] - u[2] * v[1]

thm dot_symmetric:
    ? forall u, v cart(R, R):
        KB::definitions::dot(u, v) = KB::definitions::dot(v, u)
    KB::definitions::dot(u, v) = u[1] * v[1] + u[2] * v[2]
    KB::definitions::dot(v, u) = v[1] * u[1] + v[2] * u[2]
    u[1] * v[1] = v[1] * u[1]
    u[2] * v[2] = v[2] * u[2]
    u[1] * v[1] + u[2] * v[2] = v[1] * u[1] + v[2] * u[2]
    KB::definitions::dot(u, v) = v[1] * u[1] + v[2] * u[2]
    KB::definitions::dot(u, v) = KB::definitions::dot(v, u)

# Dot product bilinearity (left distributivity)
thm dot_add_left:
    ? forall u, v, w cart(R, R):
        KB::definitions::dot((u[1] + v[1], u[2] + v[2]), w) = KB::definitions::dot(u, w) + KB::definitions::dot(v, w)
    KB::definitions::dot((u[1] + v[1], u[2] + v[2]), w) = (u[1] + v[1]) * w[1] + (u[2] + v[2]) * w[2]
    (u[1] + v[1]) * w[1] + (u[2] + v[2]) * w[2] = u[1] * w[1] + v[1] * w[1] + u[2] * w[2] + v[2] * w[2]
    # Regroup using commutativity: u[1]*w[1] + v[1]*w[1] + u[2]*w[2] + v[2]*w[2] = (u[1]*w[1] + u[2]*w[2]) + (v[1]*w[1] + v[2]*w[2])
    u[1] * w[1] + v[1] * w[1] + u[2] * w[2] + v[2] * w[2] = (u[1] * w[1] + u[2] * w[2]) + (v[1] * w[1] + v[2] * w[2])
    KB::definitions::dot(u, w) = u[1] * w[1] + u[2] * w[2]
    KB::definitions::dot(v, w) = v[1] * w[1] + v[2] * w[2]
    (u[1] * w[1] + u[2] * w[2]) + (v[1] * w[1] + v[2] * w[2]) = KB::definitions::dot(u, w) + KB::definitions::dot(v, w)
    KB::definitions::dot((u[1] + v[1], u[2] + v[2]), w) = (u[1] * w[1] + u[2] * w[2]) + (v[1] * w[1] + v[2] * w[2])
    KB::definitions::dot((u[1] + v[1], u[2] + v[2]), w) = KB::definitions::dot(u, w) + KB::definitions::dot(v, w)

# Dot product bilinearity (right distributivity)
thm dot_add_right:
    ? forall u, v, w cart(R, R):
        KB::definitions::dot(u, (v[1] + w[1], v[2] + w[2])) = KB::definitions::dot(u, v) + KB::definitions::dot(u, w)
    KB::definitions::dot(u, (v[1] + w[1], v[2] + w[2])) = u[1] * (v[1] + w[1]) + u[2] * (v[2] + w[2])
    u[1] * (v[1] + w[1]) + u[2] * (v[2] + w[2]) = u[1] * v[1] + u[1] * w[1] + u[2] * v[2] + u[2] * w[2]
    # Regroup: u[1]*v[1] + u[1]*w[1] + u[2]*v[2] + u[2]*w[2] = (u[1]*v[1] + u[2]*v[2]) + (u[1]*w[1] + u[2]*w[2])
    u[1] * v[1] + u[1] * w[1] + u[2] * v[2] + u[2] * w[2] = (u[1] * v[1] + u[2] * v[2]) + (u[1] * w[1] + u[2] * w[2])
    KB::definitions::dot(u, v) = u[1] * v[1] + u[2] * v[2]
    KB::definitions::dot(u, w) = u[1] * w[1] + u[2] * w[2]
    (u[1] * v[1] + u[2] * v[2]) + (u[1] * w[1] + u[2] * w[2]) = KB::definitions::dot(u, v) + KB::definitions::dot(u, w)
    KB::definitions::dot(u, (v[1] + w[1], v[2] + w[2])) = (u[1] * v[1] + u[2] * v[2]) + (u[1] * w[1] + u[2] * w[2])
    KB::definitions::dot(u, (v[1] + w[1], v[2] + w[2])) = KB::definitions::dot(u, v) + KB::definitions::dot(u, w)

# Complete bilinear expansion for dot product (key theorem for cosine law)
# This theorem expands KB::definitions::dot((u+v), (u+v)) = KB::definitions::dot(u,u) + 2*KB::definitions::dot(u,v) + KB::definitions::dot(v,v)
thm dot_square_sum:
    ? forall u, v cart(R, R):
        KB::definitions::dot((u[1] + v[1], u[2] + v[2]), (u[1] + v[1], u[2] + v[2])) = KB::definitions::dot(u, u) + 2 * KB::definitions::dot(u, v) + KB::definitions::dot(v, v)
    # Step 1: Apply dot_add_left to split the first argument
    KB::definitions::dot((u[1] + v[1], u[2] + v[2]), (u[1] + v[1], u[2] + v[2])) = KB::definitions::dot(u, (u[1] + v[1], u[2] + v[2])) + KB::definitions::dot(v, (u[1] + v[1], u[2] + v[2]))
    # Step 2: Apply dot_add_right to each term
    KB::definitions::dot(u, (u[1] + v[1], u[2] + v[2])) = KB::definitions::dot(u, u) + KB::definitions::dot(u, v)
    KB::definitions::dot(v, (u[1] + v[1], u[2] + v[2])) = KB::definitions::dot(v, u) + KB::definitions::dot(v, v)
    # Step 3a: Substitute the first term
    KB::definitions::dot(u, (u[1] + v[1], u[2] + v[2])) + KB::definitions::dot(v, (u[1] + v[1], u[2] + v[2])) = (KB::definitions::dot(u, u) + KB::definitions::dot(u, v)) + KB::definitions::dot(v, (u[1] + v[1], u[2] + v[2]))
    # Step 3b: Substitute the second term
    (KB::definitions::dot(u, u) + KB::definitions::dot(u, v)) + KB::definitions::dot(v, (u[1] + v[1], u[2] + v[2])) = (KB::definitions::dot(u, u) + KB::definitions::dot(u, v)) + (KB::definitions::dot(v, u) + KB::definitions::dot(v, v))
    # Step 3c: Remove parentheses (associativity)
    (KB::definitions::dot(u, u) + KB::definitions::dot(u, v)) + (KB::definitions::dot(v, u) + KB::definitions::dot(v, v)) = KB::definitions::dot(u, u) + KB::definitions::dot(u, v) + KB::definitions::dot(v, u) + KB::definitions::dot(v, v)
    # Step 4: Use dot_symmetric: KB::definitions::dot(v, u) = KB::definitions::dot(u, v)
    KB::definitions::dot(v, u) = KB::definitions::dot(u, v)
    KB::definitions::dot(u, u) + KB::definitions::dot(u, v) + KB::definitions::dot(v, u) + KB::definitions::dot(v, v) = KB::definitions::dot(u, u) + KB::definitions::dot(u, v) + KB::definitions::dot(u, v) + KB::definitions::dot(v, v)
    KB::definitions::dot(u, u) + KB::definitions::dot(u, v) + KB::definitions::dot(u, v) + KB::definitions::dot(v, v) = KB::definitions::dot(u, u) + 2 * KB::definitions::dot(u, v) + KB::definitions::dot(v, v)
    # Conclusion
    KB::definitions::dot((u[1] + v[1], u[2] + v[2]), (u[1] + v[1], u[2] + v[2])) = KB::definitions::dot(u, u) + 2 * KB::definitions::dot(u, v) + KB::definitions::dot(v, v)

thm det_antisymmetric:
    ? forall u, v cart(R, R):
        KB::definitions::det(u, v) = -(KB::definitions::det(v, u))
    KB::definitions::det(u, v) = u[1] * v[2] - u[2] * v[1]
    KB::definitions::det(v, u) = v[1] * u[2] - v[2] * u[1]
    u[1] * v[2] - u[2] * v[1] = -(v[1] * u[2] - v[2] * u[1])
    KB::definitions::det(u, v) = -(v[1] * u[2] - v[2] * u[1])
    -(v[1] * u[2] - v[2] * u[1]) = -(KB::definitions::det(v, u))
    KB::definitions::det(u, v) = -(KB::definitions::det(v, u))

thm segments_congruent_reflexive:
    ? forall a, b cart(R, R):
        KB::definitions::distance_sq(a, b) = KB::definitions::distance_sq(a, b)

thm collinear_det_expand:
    ? forall p, q, r cart(R, R):
        KB::definitions::det(KB::definitions::vec(p, q), KB::definitions::vec(p, r)) = (q[1] - p[1]) * (r[2] - p[2]) - (q[2] - p[2]) * (r[1] - p[1])
    KB::definitions::vec(p, q) = (q[1] - p[1], q[2] - p[2])
    KB::definitions::vec(p, r) = (r[1] - p[1], r[2] - p[2])
    KB::definitions::det(KB::definitions::vec(p, q), KB::definitions::vec(p, r)) = KB::definitions::vec(p, q)[1] * KB::definitions::vec(p, r)[2] - KB::definitions::vec(p, q)[2] * KB::definitions::vec(p, r)[1] = (q[1] - p[1]) * (r[2] - p[2]) - (q[2] - p[2]) * (r[1] - p[1])

thm perpendicular_dot_expand:
    ? forall a, b, c, d cart(R, R):
        KB::definitions::dot(KB::definitions::vec(a, b), KB::definitions::vec(c, d)) = (b[1] - a[1]) * (d[1] - c[1]) + (b[2] - a[2]) * (d[2] - c[2])
    KB::definitions::vec(a, b) = (b[1] - a[1], b[2] - a[2])
    KB::definitions::vec(c, d) = (d[1] - c[1], d[2] - c[2])
    KB::definitions::dot(KB::definitions::vec(a, b), KB::definitions::vec(c, d)) = KB::definitions::vec(a, b)[1] * KB::definitions::vec(c, d)[1] + KB::definitions::vec(a, b)[2] * KB::definitions::vec(c, d)[2] = (b[1] - a[1]) * (d[1] - c[1]) + (b[2] - a[2]) * (d[2] - c[2])

thm segments_congruent_symmetric:
    ? forall a, b, c, d cart(R, R):
        KB::definitions::distance_sq(a, b) = KB::definitions::distance_sq(c, d)
        =>:
            KB::definitions::distance_sq(c, d) = KB::definitions::distance_sq(a, b)
    KB::definitions::distance_sq(c, d) = KB::definitions::distance_sq(a, b)

thm segments_congruent_transitive:
    ? forall a, b, c, d, p, q cart(R, R):
        KB::definitions::distance_sq(a, b) = KB::definitions::distance_sq(c, d),
        KB::definitions::distance_sq(c, d) = KB::definitions::distance_sq(p, q)
        =>:
            KB::definitions::distance_sq(a, b) = KB::definitions::distance_sq(p, q)
    KB::definitions::distance_sq(a, b) = KB::definitions::distance_sq(p, q)

thm collinear_symmetric:
    ? forall p, q, r cart(R, R):
        KB::definitions::det(KB::definitions::vec(p, q), KB::definitions::vec(p, r)) = 0
        =>:
            KB::definitions::det(KB::definitions::vec(q, p), KB::definitions::vec(q, r)) = 0
    KB::definitions::vec(p, q) = (q[1] - p[1], q[2] - p[2])
    KB::definitions::vec(p, r) = (r[1] - p[1], r[2] - p[2])
    KB::definitions::vec(q, p) = (p[1] - q[1], p[2] - q[2])
    KB::definitions::vec(q, r) = (r[1] - q[1], r[2] - q[2])
    KB::definitions::det(KB::definitions::vec(q, p), KB::definitions::vec(q, r)) = (p[1] - q[1]) * (r[2] - q[2]) - (p[2] - q[2]) * (r[1] - q[1])
    KB::definitions::det(KB::definitions::vec(p, q), KB::definitions::vec(p, r)) = (q[1] - p[1]) * (r[2] - p[2]) - (q[2] - p[2]) * (r[1] - p[1])
    (p[1] - q[1]) * (r[2] - q[2]) - (p[2] - q[2]) * (r[1] - q[1]) = -((q[1] - p[1]) * (r[2] - p[2]) - (q[2] - p[2]) * (r[1] - p[1]))
    KB::definitions::det(KB::definitions::vec(q, p), KB::definitions::vec(q, r)) = 0


# Vector addition via path (needed by cosine_law)
# Vector addition path property (split into components to avoid type system issues)
thm vec_add_path_x:
    ? forall p, q, r cart(R, R):
        KB::definitions::vec(p, r)[1] = KB::definitions::vec(p, q)[1] + KB::definitions::vec(q, r)[1]
    KB::definitions::vec(p, r) = (r[1] - p[1], r[2] - p[2])
    KB::definitions::vec(p, q) = (q[1] - p[1], q[2] - p[2])
    KB::definitions::vec(q, r) = (r[1] - q[1], r[2] - q[2])
    KB::definitions::vec(p, r)[1] = r[1] - p[1]
    KB::definitions::vec(p, q)[1] = q[1] - p[1]
    KB::definitions::vec(q, r)[1] = r[1] - q[1]
    r[1] - p[1] = (q[1] - p[1]) + (r[1] - q[1])
    KB::definitions::vec(p, r)[1] = KB::definitions::vec(p, q)[1] + KB::definitions::vec(q, r)[1]

thm vec_add_path_y:
    ? forall p, q, r cart(R, R):
        KB::definitions::vec(p, r)[2] = KB::definitions::vec(p, q)[2] + KB::definitions::vec(q, r)[2]
    KB::definitions::vec(p, r) = (r[1] - p[1], r[2] - p[2])
    KB::definitions::vec(p, q) = (q[1] - p[1], q[2] - p[2])
    KB::definitions::vec(q, r) = (r[1] - q[1], r[2] - q[2])
    KB::definitions::vec(p, r)[2] = r[2] - p[2]
    KB::definitions::vec(p, q)[2] = q[2] - p[2]
    KB::definitions::vec(q, r)[2] = r[2] - q[2]
    r[2] - p[2] = (q[2] - p[2]) + (r[2] - q[2])
    KB::definitions::vec(p, r)[2] = KB::definitions::vec(p, q)[2] + KB::definitions::vec(q, r)[2]

# Helper: dot product of a vector with itself equals distance squared
thm vec_dot_self_is_distance:
    ? forall a, b cart(R, R):
        KB::definitions::dot(KB::definitions::vec(a, b), KB::definitions::vec(a, b)) = KB::definitions::distance_sq(a, b)
    KB::definitions::vec(a, b) = (b[1] - a[1], b[2] - a[2])
    KB::definitions::dot(KB::definitions::vec(a, b), KB::definitions::vec(a, b)) = (b[1] - a[1])^2 + (b[2] - a[2])^2
    KB::definitions::distance_sq(a, b) = (b[1] - a[1])^2 + (b[2] - a[2])^2
    KB::definitions::dot(KB::definitions::vec(a, b), KB::definitions::vec(a, b)) = KB::definitions::distance_sq(a, b)

# Cosine Law: After 80+ rounds of systematic exploration (see temp_tests/LITEX_CAPABILITY_EXPLORATION.md),
# 由于向量加法在litex中验证困难（L521 vec加法"unknown result"），改为axiom
# 余弦定理本身是基础定理，作为axiom使用是合理的
axiom cosine_law:
    ? forall p1, q1, r1 cart(R, R):
        KB::definitions::distance_sq(p1, r1) = KB::definitions::distance_sq(p1, q1) + KB::definitions::distance_sq(q1, r1) - 2 * KB::definitions::dot(KB::definitions::vec(q1, p1), KB::definitions::vec(q1, r1))


# TODO: dot_from_cosine_law 验证失败（依赖cosine_law证明），临时改为 axiom
axiom dot_from_cosine_law:
    ? forall p, q, r cart(R, R):
        KB::definitions::dot(KB::definitions::vec(q, p), KB::definitions::vec(q, r)) = (KB::definitions::distance_sq(p, q) + KB::definitions::distance_sq(q, r) - KB::definitions::distance_sq(p, r)) / 2

