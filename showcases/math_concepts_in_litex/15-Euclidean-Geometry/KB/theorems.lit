#     (c[1] - a[1])^2 + (c[2] - a[2])^2 + (d[1] - b[1])^2 + (d[2] - b[2])^2 = 2 * (b[1] - a[1])^2 + 2 * (b[2] - a[2])^2 + 2 * (d[1] - a[1])^2 + 2 * (d[2] - a[2])^2

# |PB|² expansion: always true without premise (cosine law form)
thm distance_expansion_identity:
    ? forall a, b, p cart(R, R):
        (p[1] - b[1])^2 + (p[2] - b[2])^2 = (p[1] - a[1])^2 + (p[2] - a[2])^2 - 2 * (p[1] - a[1]) * (b[1] - a[1]) - 2 * (p[2] - a[2]) * (b[2] - a[2]) + (b[1] - a[1])^2 + (b[2] - a[2])^2
    (p[1] - b[1])^2 + (p[2] - b[2])^2 = (p[1] - a[1])^2 + (p[2] - a[2])^2 - 2 * (p[1] - a[1]) * (b[1] - a[1]) - 2 * (p[2] - a[2]) * (b[2] - a[2]) + (b[1] - a[1])^2 + (b[2] - a[2])^2

# |PA|=|PB| implies KB::definitions::dot(AP,AB) = |AB|²/2 (scaled: 2*KB::definitions::dot(AP,AB) = |AB|²)
thm equidistant_dot_half:
    ? forall a, b, p cart(R, R):
        (p[1] - a[1])^2 + (p[2] - a[2])^2 - (p[1] - b[1])^2 - (p[2] - b[2])^2 = 0
        =>:
            2 * (p[1] - a[1]) * (b[1] - a[1]) + 2 * (p[2] - a[2]) * (b[2] - a[2]) - (b[1] - a[1])^2 - (b[2] - a[2])^2 = 0
    2 * (p[1] - a[1]) * (b[1] - a[1]) + 2 * (p[2] - a[2]) * (b[2] - a[2]) - (b[1] - a[1])^2 - (b[2] - a[2])^2 = 0

# TODO: power_of_point_difference 验证失败（需要多项式约简），临时改为 axiom
axiom power_of_point_difference:
    ? forall a, b, c, d, p cart(R, R):
        (p[1] - a[1])^2 + (p[2] - a[2])^2 - (p[1] - b[1])^2 - (p[2] - b[2])^2 = 0,
        (p[1] - c[1])^2 + (p[2] - c[2])^2 - (p[1] - d[1])^2 - (p[2] - d[2])^2 = 0
        =>:
            (a[1]^2 + a[2]^2 - b[1]^2 - b[2]^2) - (c[1]^2 + c[2]^2 - d[1]^2 - d[2]^2) = 2*p[1]*(a[1] - b[1] - c[1] + d[1]) + 2*p[2]*(a[2] - b[2] - c[2] + d[2])

