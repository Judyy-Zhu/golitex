#     KB::definitions::dot(KB::definitions::vec(p, q), KB::definitions::vec(p, r)) = (q[1] - p[1]) * (r[1] - p[1]) + (q[2] - p[2]) * (r[2] - p[2])
#     KB::definitions::distance_sq(p, q) = (q[1] - p[1])^2 + (q[2] - p[2])^2
#     (p[1] - q[1]) * (r[1] - q[1]) + (p[2] - q[2]) * (r[2] - q[2]) + ((q[1] - p[1]) * (r[1] - p[1]) + (q[2] - p[2]) * (r[2] - p[2])) = (q[1] - p[1])^2 + (q[2] - p[2])^2
#     KB::definitions::dot(KB::definitions::vec(q, p), KB::definitions::vec(q, r)) + KB::definitions::dot(KB::definitions::vec(p, q), KB::definitions::vec(p, r)) = KB::definitions::distance_sq(p, q)

thm collinear_third:
    ? forall p, q, r cart(R, R):
        KB::definitions::det(KB::definitions::vec(p, q), KB::definitions::vec(p, r)) = 0
        =>:
            KB::definitions::det(KB::definitions::vec(r, p), KB::definitions::vec(r, q)) = 0
    KB::definitions::vec(p, q) = (q[1] - p[1], q[2] - p[2])
    KB::definitions::vec(p, r) = (r[1] - p[1], r[2] - p[2])
    KB::definitions::vec(r, p) = (p[1] - r[1], p[2] - r[2])
    KB::definitions::vec(r, q) = (q[1] - r[1], q[2] - r[2])
    KB::definitions::det(KB::definitions::vec(p, q), KB::definitions::vec(p, r)) = (q[1] - p[1]) * (r[2] - p[2]) - (q[2] - p[2]) * (r[1] - p[1])
    KB::definitions::det(KB::definitions::vec(r, p), KB::definitions::vec(r, q)) = (p[1] - r[1]) * (q[2] - r[2]) - (p[2] - r[2]) * (q[1] - r[1])
    (p[1] - r[1]) * (q[2] - r[2]) - (p[2] - r[2]) * (q[1] - r[1]) = (q[1] - p[1]) * (r[2] - p[2]) - (q[2] - p[2]) * (r[1] - p[1])
    KB::definitions::det(KB::definitions::vec(r, p), KB::definitions::vec(r, q)) = 0

thm parallelogram_sides:
    ? forall a, b, c, d cart(R, R):
        d[1] = a[1] + c[1] - b[1],
        d[2] = a[2] + c[2] - b[2]
        =>:
            KB::definitions::distance_sq(a, d) = KB::definitions::distance_sq(b, c)
    KB::definitions::distance_sq(a, d) = (d[1] - a[1])^2 + (d[2] - a[2])^2
    KB::definitions::distance_sq(b, c) = (c[1] - b[1])^2 + (c[2] - b[2])^2
    (d[1] - a[1])^2 + (d[2] - a[2])^2 = ((a[1] + c[1] - b[1]) - a[1])^2 + ((a[2] + c[2] - b[2]) - a[2])^2
    ((a[1] + c[1] - b[1]) - a[1])^2 + ((a[2] + c[2] - b[2]) - a[2])^2 = (c[1] - b[1])^2 + (c[2] - b[2])^2
    KB::definitions::distance_sq(a, d) = KB::definitions::distance_sq(b, c)

thm circumcenter_equidistant:
    ? forall a, b, c, o cart(R, R):
        KB::definitions::distance_sq(o, a) = KB::definitions::distance_sq(o, b),
        KB::definitions::distance_sq(o, b) = KB::definitions::distance_sq(o, c)
        =>:
            KB::definitions::distance_sq(o, a) = KB::definitions::distance_sq(o, c)
    KB::definitions::distance_sq(o, a) = KB::definitions::distance_sq(o, c)

thm thales_theorem:
    ? forall a, b, p cart(R, R):
        (p[1] - (a[1] + b[1]) / 2)^2 + (p[2] - (a[2] + b[2]) / 2)^2 - (a[1] - (a[1] + b[1]) / 2)^2 - (a[2] - (a[2] + b[2]) / 2)^2 = 0
        =>:
            KB::definitions::dot(KB::definitions::vec(p, a), KB::definitions::vec(p, b)) = 0
    KB::definitions::vec(p, a) = (a[1] - p[1], a[2] - p[2])
    KB::definitions::vec(p, b) = (b[1] - p[1], b[2] - p[2])
    KB::definitions::dot(KB::definitions::vec(p, a), KB::definitions::vec(p, b)) = (a[1] - p[1]) * (b[1] - p[1]) + (a[2] - p[2]) * (b[2] - p[2])
    (a[1] - p[1]) * (b[1] - p[1]) + (a[2] - p[2]) * (b[2] - p[2]) = (p[1] - (a[1] + b[1]) / 2)^2 + (p[2] - (a[2] + b[2]) / 2)^2 - (a[1] - (a[1] + b[1]) / 2)^2 - (a[2] - (a[2] + b[2]) / 2)^2
    KB::definitions::dot(KB::definitions::vec(p, a), KB::definitions::vec(p, b)) = 0

thm thales_converse:
    ? forall a, b, p cart(R, R):
        KB::definitions::dot(KB::definitions::vec(p, a), KB::definitions::vec(p, b)) = 0
        =>:
            (p[1] - (a[1] + b[1]) / 2)^2 + (p[2] - (a[2] + b[2]) / 2)^2 - (a[1] - (a[1] + b[1]) / 2)^2 - (a[2] - (a[2] + b[2]) / 2)^2 = 0
    KB::definitions::vec(p, a) = (a[1] - p[1], a[2] - p[2])
    KB::definitions::vec(p, b) = (b[1] - p[1], b[2] - p[2])
    KB::definitions::dot(KB::definitions::vec(p, a), KB::definitions::vec(p, b)) = (a[1] - p[1]) * (b[1] - p[1]) + (a[2] - p[2]) * (b[2] - p[2])
    (a[1] - p[1]) * (b[1] - p[1]) + (a[2] - p[2]) * (b[2] - p[2]) = (p[1] - (a[1] + b[1]) / 2)^2 + (p[2] - (a[2] + b[2]) / 2)^2 - (a[1] - (a[1] + b[1]) / 2)^2 - (a[2] - (a[2] + b[2]) / 2)^2
    (p[1] - (a[1] + b[1]) / 2)^2 + (p[2] - (a[2] + b[2]) / 2)^2 - (a[1] - (a[1] + b[1]) / 2)^2 - (a[2] - (a[2] + b[2]) / 2)^2 = 0
# ═══════════════════════════════════════════════════════════════════════
# Layer 1: Derived theorems (cite Layer 0 theorems by forall instantiation)
# ═══════════════════════════════════════════════════════════════════════

# TODO: sas_third_side 验证失败（代数推导问题），临时改为 axiom
axiom sas_third_side:
    ? forall p, q, r, u, v, w cart(R, R):
        KB::definitions::distance_sq(p, q) = KB::definitions::distance_sq(u, v),
        KB::definitions::distance_sq(q, r) = KB::definitions::distance_sq(v, w),
        KB::definitions::dot(KB::definitions::vec(q, p), KB::definitions::vec(q, r)) = KB::definitions::dot(KB::definitions::vec(v, u), KB::definitions::vec(v, w))
        =>:
            KB::definitions::distance_sq(p, r) = KB::definitions::distance_sq(u, w)

# ═══════════════════════════════════════════════════════════════════════
# 完整的三角形全等定理（Complete Triangle Congruence Theorems）
# ═══════════════════════════════════════════════════════════════════════

# SAS全等（边角边）- 完整版
# 给定两边及其夹角相等，则两三角形全等（所有对应边和角相等）
axiom sas_congruence:
    ? forall p, q, r, u, v, w cart(R, R):
        # SAS条件：两边及夹角
        KB::definitions::distance_sq(p, q) = KB::definitions::distance_sq(u, v),
        KB::definitions::distance_sq(q, r) = KB::definitions::distance_sq(v, w),
        KB::definitions::dot(KB::definitions::vec(q, p), KB::definitions::vec(q, r)) = KB::definitions::dot(KB::definitions::vec(v, u), KB::definitions::vec(v, w))
        =>:
            # 结论：所有对应边相等
            KB::definitions::distance_sq(p, r) = KB::definitions::distance_sq(u, w),
            KB::definitions::distance_sq(p, q) = KB::definitions::distance_sq(u, v),
            KB::definitions::distance_sq(q, r) = KB::definitions::distance_sq(v, w),
            # 所有对应角相等（用dot表示）
            KB::definitions::dot(KB::definitions::vec(p, q), KB::definitions::vec(p, r)) = KB::definitions::dot(KB::definitions::vec(u, v), KB::definitions::vec(u, w)),
            KB::definitions::dot(KB::definitions::vec(r, p), KB::definitions::vec(r, q)) = KB::definitions::dot(KB::definitions::vec(w, u), KB::definitions::vec(w, v))

# SSS全等（边边边）- 完整版
# 给定三边对应相等，则两三角形全等（所有对应角相等）
axiom sss_congruence:
    ? forall p, q, r, u, v, w cart(R, R):
        # SSS条件：三边相等
        KB::definitions::distance_sq(p, q) = KB::definitions::distance_sq(u, v),
        KB::definitions::distance_sq(q, r) = KB::definitions::distance_sq(v, w),
        KB::definitions::distance_sq(p, r) = KB::definitions::distance_sq(u, w)
        =>:
            # 结论：所有对应角相等
            KB::definitions::dot(KB::definitions::vec(p, q), KB::definitions::vec(p, r)) = KB::definitions::dot(KB::definitions::vec(u, v), KB::definitions::vec(u, w)),
            KB::definitions::dot(KB::definitions::vec(q, p), KB::definitions::vec(q, r)) = KB::definitions::dot(KB::definitions::vec(v, u), KB::definitions::vec(v, w)),
            KB::definitions::dot(KB::definitions::vec(r, p), KB::definitions::vec(r, q)) = KB::definitions::dot(KB::definitions::vec(w, u), KB::definitions::vec(w, v))

# ASA全等（角边角）- 完整版
# 给定两角及其夹边相等，则两三角形全等（所有对应边相等）
axiom asa_congruence:
    ? forall p, q, r, u, v, w cart(R, R):
        # 非退化条件
        p != q, q != r, r != p,
        u != v, v != w, w != u,
        # ASA条件：两角及夹边
        KB::definitions::distance_sq(p, q) = KB::definitions::distance_sq(u, v),
        KB::definitions::dot(KB::definitions::vec(p, q), KB::definitions::vec(p, r)) * KB::definitions::distance_sq(v, w) = KB::definitions::dot(KB::definitions::vec(u, v), KB::definitions::vec(u, w)) * KB::definitions::distance_sq(q, r),
        KB::definitions::dot(KB::definitions::vec(q, p), KB::definitions::vec(q, r)) * KB::definitions::distance_sq(w, u) = KB::definitions::dot(KB::definitions::vec(v, u), KB::definitions::vec(v, w)) * KB::definitions::distance_sq(r, p)
        =>:
            # 结论：所有对应边相等
            KB::definitions::distance_sq(q, r) = KB::definitions::distance_sq(v, w),
            KB::definitions::distance_sq(p, r) = KB::definitions::distance_sq(u, w)

# 原证明（验证失败，待修复）：
