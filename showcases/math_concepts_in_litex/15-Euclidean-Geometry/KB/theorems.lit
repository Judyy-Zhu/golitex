thm perpendicular_from_parallel:
    ? forall a, b, c, d cart(R, R):
        KB::definitions::det(KB::definitions::vec(a, b), KB::definitions::vec(c, d)) = 0,
        KB::definitions::dot(KB::definitions::vec(a, b), KB::definitions::vec(a, b)) != 0
        =>:
            KB::definitions::dot(KB::definitions::vec(a, b), (KB::definitions::vec(c, d)[2], -(KB::definitions::vec(c, d)[1]))) = 0
    KB::definitions::vec(a, b) = (b[1] - a[1], b[2] - a[2])
    KB::definitions::vec(c, d) = (d[1] - c[1], d[2] - c[2])
    KB::definitions::dot(KB::definitions::vec(a, b), (KB::definitions::vec(c, d)[2], -(KB::definitions::vec(c, d)[1]))) = (b[1] - a[1]) * (d[2] - c[2]) - (b[2] - a[2]) * (d[1] - c[1])
    KB::definitions::det(KB::definitions::vec(a, b), KB::definitions::vec(c, d)) = (b[1] - a[1]) * (d[2] - c[2]) - (b[2] - a[2]) * (d[1] - c[1])
    KB::definitions::dot(KB::definitions::vec(a, b), (KB::definitions::vec(c, d)[2], -(KB::definitions::vec(c, d)[1]))) = 0

thm median_length:
    ? forall a, b, c, m cart(R, R):
        m[1] = (b[1] + c[1]) / 2,
        m[2] = (b[2] + c[2]) / 2
        =>:
            4 * KB::definitions::distance_sq(a, m) = 2 * KB::definitions::distance_sq(a, b) + 2 * KB::definitions::distance_sq(a, c) - KB::definitions::distance_sq(b, c)
    KB::definitions::distance_sq(a, m) = (m[1] - a[1])^2 + (m[2] - a[2])^2
    KB::definitions::distance_sq(a, b) = (b[1] - a[1])^2 + (b[2] - a[2])^2
    KB::definitions::distance_sq(a, c) = (c[1] - a[1])^2 + (c[2] - a[2])^2
    KB::definitions::distance_sq(b, c) = (c[1] - b[1])^2 + (c[2] - b[2])^2
    (m[1] - a[1])^2 + (m[2] - a[2])^2 = ((b[1] + c[1]) / 2 - a[1])^2 + ((b[2] + c[2]) / 2 - a[2])^2
    4 * (((b[1] + c[1]) / 2 - a[1])^2 + ((b[2] + c[2]) / 2 - a[2])^2) = 2 * ((b[1] - a[1])^2 + (b[2] - a[2])^2) + 2 * ((c[1] - a[1])^2 + (c[2] - a[2])^2) - ((c[1] - b[1])^2 + (c[2] - b[2])^2)
    4 * KB::definitions::distance_sq(a, m) = 2 * KB::definitions::distance_sq(a, b) + 2 * KB::definitions::distance_sq(a, c) - KB::definitions::distance_sq(b, c)

thm reflection_distance:
    ? forall p, a, b cart(R, R):
        b[1] = 2 * a[1] - p[1],
        b[2] = 2 * a[2] - p[2]
        =>:
            KB::definitions::distance_sq(a, p) = KB::definitions::distance_sq(a, b)
    KB::definitions::distance_sq(a, p) = (p[1] - a[1])^2 + (p[2] - a[2])^2
    KB::definitions::distance_sq(a, b) = (b[1] - a[1])^2 + (b[2] - a[2])^2
    (b[1] - a[1])^2 + (b[2] - a[2])^2 = ((2 * a[1] - p[1]) - a[1])^2 + ((2 * a[2] - p[2]) - a[2])^2
    ((2 * a[1] - p[1]) - a[1])^2 + ((2 * a[2] - p[2]) - a[2])^2 = (p[1] - a[1])^2 + (p[2] - a[2])^2
    KB::definitions::distance_sq(a, p) = KB::definitions::distance_sq(a, b)

thm foot_perp_parametric:
    ? forall a, b, p, f cart(R, R), t R:
        f[1] = a[1] + t * (b[1] - a[1]),
        f[2] = a[2] + t * (b[2] - a[2]),
        (p[1] - a[1]) * (b[1] - a[1]) + (p[2] - a[2]) * (b[2] - a[2]) = t * ((b[1] - a[1])^2 + (b[2] - a[2])^2)
        =>:
            KB::definitions::dot(KB::definitions::vec(p, f), KB::definitions::vec(a, b)) = 0
    KB::definitions::vec(p, f) = (f[1] - p[1], f[2] - p[2])
    KB::definitions::vec(a, b) = (b[1] - a[1], b[2] - a[2])
    KB::definitions::dot(KB::definitions::vec(p, f), KB::definitions::vec(a, b)) = (f[1] - p[1]) * (b[1] - a[1]) + (f[2] - p[2]) * (b[2] - a[2])
    (f[1] - p[1]) * (b[1] - a[1]) + (f[2] - p[2]) * (b[2] - a[2]) = (a[1] + t * (b[1] - a[1]) - p[1]) * (b[1] - a[1]) + (a[2] + t * (b[2] - a[2]) - p[2]) * (b[2] - a[2])
    (a[1] + t * (b[1] - a[1]) - p[1]) * (b[1] - a[1]) + (a[2] + t * (b[2] - a[2]) - p[2]) * (b[2] - a[2]) = t * ((b[1] - a[1])^2 + (b[2] - a[2])^2) - ((p[1] - a[1]) * (b[1] - a[1]) + (p[2] - a[2]) * (b[2] - a[2]))
    t * ((b[1] - a[1])^2 + (b[2] - a[2])^2) - ((p[1] - a[1]) * (b[1] - a[1]) + (p[2] - a[2]) * (b[2] - a[2])) = 0
    KB::definitions::dot(KB::definitions::vec(p, f), KB::definitions::vec(a, b)) = 0

# TODO: midpoint_segment_ratio 验证失败（代数推导问题），临时改为 axiom
axiom midpoint_segment_ratio:
    ? forall a, b, m, p cart(R, R), t R:
        m[1] = (a[1] + b[1]) / 2,
        m[2] = (a[2] + b[2]) / 2,
        p[1] = (1 - t) * a[1] + t * b[1],
        p[2] = (1 - t) * a[2] + t * b[2]
        =>:
            KB::definitions::distance_sq(a, p) = (2 * t)^2 * KB::definitions::distance_sq(a, m)

