# TODO: collinear_implies_midpoint_distance 验证失败（需要多项式约简），临时改为 axiom
axiom collinear_implies_midpoint_distance:
    ? forall a, b, m cart(R, R):
        (m[1] - a[1]) * (b[2] - a[2]) - (m[2] - a[2]) * (b[1] - a[1]) = 0,
        m[1] - (a[1] + b[1]) / 2 = 0,
        m[2] - (a[2] + b[2]) / 2 = 0
        =>:
            (m[1] - a[1])^2 + (m[2] - a[2])^2 - (m[1] - b[1])^2 - (m[2] - b[2])^2 = 0

# 原证明（验证失败，待修复）：
# thm collinear_implies_midpoint_distance:
#     ? forall a, b, m cart(R, R):
#         (m[1] - a[1]) * (b[2] - a[2]) - (m[2] - a[2]) * (b[1] - a[1]) = 0
#         m[1] - (a[1] + b[1]) / 2 = 0
#         m[2] - (a[2] + b[2]) / 2 = 0
#         =>:
#             (m[1] - a[1])^2 + (m[2] - a[2])^2 - (m[1] - b[1])^2 - (m[2] - b[2])^2 = 0
#     (m[1] - a[1])^2 + (m[2] - a[2])^2 - (m[1] - b[1])^2 - (m[2] - b[2])^2 = 0

# TODO: isosceles_implies_equal_projections 验证失败（需要多项式约简），临时改为 axiom
axiom isosceles_implies_equal_projections:
    ? forall a, b, c cart(R, R):
        (c[1] - a[1])^2 + (c[2] - a[2])^2 - (c[1] - b[1])^2 - (c[2] - b[2])^2 = 0
        =>:
            (a[1] - c[1]) * (b[1] - a[1]) + (a[2] - c[2]) * (b[2] - a[2]) - (b[1] - c[1]) * (a[1] - b[1]) - (b[2] - c[2]) * (a[2] - b[2]) = 0

# 原证明（验证失败，待修复）：
# thm isosceles_implies_equal_projections:
#     ? forall a, b, c cart(R, R):
#         (c[1] - a[1])^2 + (c[2] - a[2])^2 - (c[1] - b[1])^2 - (c[2] - b[2])^2 = 0
