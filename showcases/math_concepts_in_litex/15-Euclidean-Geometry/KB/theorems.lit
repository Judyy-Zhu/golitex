#     (2 * p[1] - a[1] - b[1])^2 + (2 * p[2] - a[2] - b[2])^2 = (a[1] - b[1])^2 + (a[2] - b[2])^2

# |PA|=|PB| implies P on perpendicular bisector of AB
thm equidistant_perp_bisector:
    ? forall a, b, p cart(R, R):
        (p[1] - a[1])^2 + (p[2] - a[2])^2 - (p[1] - b[1])^2 - (p[2] - b[2])^2 = 0
        =>:
            (2 * p[1] - a[1] - b[1]) * (b[1] - a[1]) + (2 * p[2] - a[2] - b[2]) * (b[2] - a[2]) = 0
    (2 * p[1] - a[1] - b[1]) * (b[1] - a[1]) + (2 * p[2] - a[2] - b[2]) * (b[2] - a[2]) = 0

# TODO: parallelogram_diagonal_sum 验证失败（需要多项式约简），临时改为 axiom
axiom parallelogram_diagonal_sum:
    ? forall a, b, c, d cart(R, R):
        b[1] - a[1] - c[1] + d[1] = 0,
        b[2] - a[2] - c[2] + d[2] = 0
        =>:
            (c[1] - a[1])^2 + (c[2] - a[2])^2 + (d[1] - b[1])^2 + (d[2] - b[2])^2 = 2 * (b[1] - a[1])^2 + 2 * (b[2] - a[2])^2 + 2 * (d[1] - a[1])^2 + 2 * (d[2] - a[2])^2

# 原证明（验证失败，待修复）：
