#         (h[1] - b[1]) * (c[1] - a[1]) + (h[2] - b[2]) * (c[2] - a[2]) = 0
#         =>:
#             (h[1] - c[1]) * (b[1] - a[1]) + (h[2] - c[2]) * (b[2] - a[2]) = 0
#     (h[1] - c[1]) * (b[1] - a[1]) + (h[2] - c[2]) * (b[2] - a[2]) = 0

# TODO: circumcenter_equidistant_triple 验证失败（需要多项式约简），临时改为 axiom
axiom circumcenter_equidistant_triple:
    ? forall a, b, c, o cart(R, R):
        (o[1] - a[1])^2 + (o[2] - a[2])^2 - (o[1] - b[1])^2 - (o[2] - b[2])^2 = 0,
        (o[1] - a[1])^2 + (o[2] - a[2])^2 - (o[1] - c[1])^2 - (o[2] - c[2])^2 = 0
        =>:
            (o[1] - b[1])^2 + (o[2] - b[2])^2 - (o[1] - c[1])^2 - (o[2] - c[2])^2 = 0

# 原证明（验证失败，待修复）：
