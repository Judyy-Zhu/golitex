axiom isosceles_right_hypotenuse_length:
    ? forall a, f, e2 cart(R, R), leg_sq R:
        KB::definitions::distance_sq(f, a) = leg_sq,
        KB::definitions::distance_sq(f, e2) = leg_sq,
        KB::definitions::dot(KB::definitions::vec(f, a), KB::definitions::vec(f, e2)) = 0
        =>:
            KB::definitions::distance_sq(a, e2) = 2 * leg_sq

