#         (o[1] - a[1])^2 + (o[2] - a[2])^2 - (o[1] - c[1])^2 - (o[2] - c[2])^2 = 0
#         =>:
#             (o[1] - b[1])^2 + (o[2] - b[2])^2 - (o[1] - c[1])^2 - (o[2] - c[2])^2 = 0
#     (o[1] - b[1])^2 + (o[2] - b[2])^2 - (o[1] - c[1])^2 - (o[2] - c[2])^2 = 0

# TODO: parallelogram_midpoint_diagonals 验证失败（需要多项式约简），临时改为 axiom
axiom parallelogram_midpoint_diagonals:
    ? forall a, b, c, d cart(R, R):
        (b[1] - a[1]) - (c[1] - d[1]) = 0,
        (b[2] - a[2]) - (c[2] - d[2]) = 0
        =>:
            (a[1] + c[1]) / 2 - (b[1] + d[1]) / 2 = 0,
            (a[2] + c[2]) / 2 - (b[2] + d[2]) / 2 = 0

# 原证明（验证失败，待修复）：
# thm parallelogram_midpoint_diagonals:
#     ? forall a, b, c, d cart(R, R):
#         (b[1] - a[1]) - (c[1] - d[1]) = 0
#         (b[2] - a[2]) - (c[2] - d[2]) = 0
#         =>:
#             (a[1] + c[1]) / 2 - (b[1] + d[1]) / 2 = 0
#             (a[2] + c[2]) / 2 - (b[2] + d[2]) / 2 = 0
#     (a[1] + c[1]) / 2 - (b[1] + d[1]) / 2 = 0
#     (a[2] + c[2]) / 2 - (b[2] + d[2]) / 2 = 0

# reflection: if B = 2M - A (reflection of A over M), then |MA| = |MB|
thm reflection_equidistant:
    ? forall a, m cart(R, R):
        =>:
            (m[1] - a[1])^2 + (m[2] - a[2])^2 = (m[1] - (2*m[1] - a[1]))^2 + (m[2] - (2*m[2] - a[2]))^2
    (m[1] - a[1])^2 + (m[2] - a[2])^2 = (m[1] - (2*m[1] - a[1]))^2 + (m[2] - (2*m[2] - a[2]))^2

# TODO: concyclic_fourth_point 验证失败（需要多项式约简），临时改为 axiom
axiom concyclic_fourth_point:
    ? forall a, b, c, d, o cart(R, R):
        (o[1] - a[1])^2 + (o[2] - a[2])^2 - (o[1] - b[1])^2 - (o[2] - b[2])^2 = 0,
        (o[1] - a[1])^2 + (o[2] - a[2])^2 - (o[1] - c[1])^2 - (o[2] - c[2])^2 = 0,
        (o[1] - a[1])^2 + (o[2] - a[2])^2 - (o[1] - d[1])^2 - (o[2] - d[2])^2 = 0
        =>:
            (o[1] - c[1])^2 + (o[2] - c[2])^2 - (o[1] - d[1])^2 - (o[2] - d[2])^2 = 0

# 原证明（验证失败，待修复）：
