#     ? forall p, q, r, u, v, w cart(R, R):
#         KB::definitions::distance_sq(p, q) = KB::definitions::distance_sq(u, v),
#         KB::definitions::distance_sq(q, r) = KB::definitions::distance_sq(v, w),
#         KB::definitions::dot(KB::definitions::vec(q, p), KB::definitions::vec(q, r)) = KB::definitions::dot(KB::definitions::vec(v, u), KB::definitions::vec(v, w))
#         =>:
#             KB::definitions::distance_sq(p, r) = KB::definitions::distance_sq(u, w)
#     KB::definitions::distance_sq(p, r) = KB::definitions::distance_sq(p, q) + KB::definitions::distance_sq(q, r) - 2 * KB::definitions::dot(KB::definitions::vec(q, p), KB::definitions::vec(q, r))
#     KB::definitions::distance_sq(u, w) = KB::definitions::distance_sq(u, v) + KB::definitions::distance_sq(v, w) - 2 * KB::definitions::dot(KB::definitions::vec(v, u), KB::definitions::vec(v, w))
#     KB::definitions::distance_sq(p, r) = KB::definitions::distance_sq(u, w)

thm perpendicular_symmetric:
    ? forall a, b, c, d cart(R, R):
        KB::definitions::dot(KB::definitions::vec(a, b), KB::definitions::vec(c, d)) = 0
        =>:
            KB::definitions::dot(KB::definitions::vec(c, d), KB::definitions::vec(a, b)) = 0
    KB::definitions::dot(KB::definitions::vec(c, d), KB::definitions::vec(a, b)) = KB::definitions::dot(KB::definitions::vec(a, b), KB::definitions::vec(c, d))
    KB::definitions::dot(KB::definitions::vec(c, d), KB::definitions::vec(a, b)) = 0

thm parallel_symmetric:
    ? forall a, b, c, d cart(R, R):
        KB::definitions::det(KB::definitions::vec(a, b), KB::definitions::vec(c, d)) = 0
        =>:
            KB::definitions::det(KB::definitions::vec(c, d), KB::definitions::vec(a, b)) = 0
    KB::definitions::det(KB::definitions::vec(c, d), KB::definitions::vec(a, b)) = -(KB::definitions::det(KB::definitions::vec(a, b), KB::definitions::vec(c, d)))
    KB::definitions::det(KB::definitions::vec(c, d), KB::definitions::vec(a, b)) = 0

# TODO: sss_dot_equal 验证失败（代数推导问题），临时改为 axiom
axiom sss_dot_equal:
    ? forall p, q, r, u, v, w cart(R, R):
        KB::definitions::distance_sq(p, q) = KB::definitions::distance_sq(u, v),
        KB::definitions::distance_sq(q, r) = KB::definitions::distance_sq(v, w),
        KB::definitions::distance_sq(p, r) = KB::definitions::distance_sq(u, w)
        =>:
            KB::definitions::dot(KB::definitions::vec(q, p), KB::definitions::vec(q, r)) = KB::definitions::dot(KB::definitions::vec(v, u), KB::definitions::vec(v, w))

# 原证明（验证失败，待修复）：
# thm sss_dot_equal:
#     ? forall p, q, r, u, v, w cart(R, R):
#         KB::definitions::distance_sq(p, q) = KB::definitions::distance_sq(u, v),
#         KB::definitions::distance_sq(q, r) = KB::definitions::distance_sq(v, w),
#         KB::definitions::distance_sq(p, r) = KB::definitions::distance_sq(u, w)
#         =>:
#             KB::definitions::dot(KB::definitions::vec(q, p), KB::definitions::vec(q, r)) = KB::definitions::dot(KB::definitions::vec(v, u), KB::definitions::vec(v, w))
#     KB::definitions::dot(KB::definitions::vec(q, p), KB::definitions::vec(q, r)) = (KB::definitions::distance_sq(p, q) + KB::definitions::distance_sq(q, r) - KB::definitions::distance_sq(p, r)) / 2
#     KB::definitions::dot(KB::definitions::vec(v, u), KB::definitions::vec(v, w)) = (KB::definitions::distance_sq(u, v) + KB::definitions::distance_sq(v, w) - KB::definitions::distance_sq(u, w)) / 2
#     KB::definitions::dot(KB::definitions::vec(q, p), KB::definitions::vec(q, r)) = KB::definitions::dot(KB::definitions::vec(v, u), KB::definitions::vec(v, w))

thm isosceles_base_dot:
    ? forall a, b, c cart(R, R):
        KB::definitions::distance_sq(a, b) = KB::definitions::distance_sq(a, c)
        =>:
            KB::definitions::dot(KB::definitions::vec(b, a), KB::definitions::vec(b, c)) = KB::definitions::dot(KB::definitions::vec(c, a), KB::definitions::vec(c, b))
    KB::definitions::dot(KB::definitions::vec(b, a), KB::definitions::vec(b, c)) = (KB::definitions::distance_sq(a, b) + KB::definitions::distance_sq(b, c) - KB::definitions::distance_sq(a, c)) / 2
    KB::definitions::dot(KB::definitions::vec(c, a), KB::definitions::vec(c, b)) = (KB::definitions::distance_sq(a, c) + KB::definitions::distance_sq(c, b) - KB::definitions::distance_sq(a, b)) / 2
    KB::definitions::distance_sq(b, c) = KB::definitions::distance_sq(c, b)
    KB::definitions::dot(KB::definitions::vec(b, a), KB::definitions::vec(b, c)) = KB::definitions::dot(KB::definitions::vec(c, a), KB::definitions::vec(c, b))

thm pythagorean_theorem:
    ? forall a, b, c cart(R, R):
        KB::definitions::dot(KB::definitions::vec(b, a), KB::definitions::vec(b, c)) = 0
        =>:
            KB::definitions::distance_sq(a, c) = KB::definitions::distance_sq(a, b) + KB::definitions::distance_sq(b, c)
    KB::definitions::distance_sq(a, c) = KB::definitions::distance_sq(a, b) + KB::definitions::distance_sq(b, c) - 2 * KB::definitions::dot(KB::definitions::vec(b, a), KB::definitions::vec(b, c))
    KB::definitions::distance_sq(a, b) + KB::definitions::distance_sq(b, c) - 2 * KB::definitions::dot(KB::definitions::vec(b, a), KB::definitions::vec(b, c)) = KB::definitions::distance_sq(a, b) + KB::definitions::distance_sq(b, c)
    KB::definitions::distance_sq(a, c) = KB::definitions::distance_sq(a, b) + KB::definitions::distance_sq(b, c)

# ═══════════════════════════════════════════════════════════════════════
# Layer 2: Advanced coordinate theorems (pure polynomial identities)
# ═══════════════════════════════════════════════════════════════════════

# TODO: stewart_theorem 验证失败（代数推导问题），临时改为 axiom
axiom stewart_theorem:
    ? forall a, b, c, d cart(R, R), t R:
        d[1] = (1 - t) * b[1] + t * c[1],
        d[2] = (1 - t) * b[2] + t * c[2]
        =>:
            KB::definitions::distance_sq(a, d) = (1 - t) * KB::definitions::distance_sq(a, b) + t * KB::definitions::distance_sq(a, c) - t * (1 - t) * KB::definitions::distance_sq(b, c)

# 原证明（验证失败，待修复）：
# thm stewart_theorem:
#     ? forall a, b, c, d cart(R, R), t R:
#         d[1] = (1 - t) * b[1] + t * c[1],
#         d[2] = (1 - t) * b[2] + t * c[2]
#         =>:
#             KB::definitions::distance_sq(a, d) = (1 - t) * KB::definitions::distance_sq(a, b) + t * KB::definitions::distance_sq(a, c) - t * (1 - t) * KB::definitions::distance_sq(b, c)
#     KB::definitions::distance_sq(a, d) = (d[1] - a[1])^2 + (d[2] - a[2])^2
#     KB::definitions::distance_sq(a, b) = (b[1] - a[1])^2 + (b[2] - a[2])^2
#     KB::definitions::distance_sq(a, c) = (c[1] - a[1])^2 + (c[2] - a[2])^2
#     KB::definitions::distance_sq(b, c) = (c[1] - b[1])^2 + (c[2] - b[2])^2
#     (d[1] - a[1])^2 + (d[2] - a[2])^2 = (((1 - t) * b[1] + t * c[1]) - a[1])^2 + (((1 - t) * b[2] + t * c[2]) - a[2])^2
#     (((1 - t) * b[1] + t * c[1]) - a[1])^2 + (((1 - t) * b[2] + t * c[2]) - a[2])^2 = (1 - t) * ((b[1] - a[1])^2 + (b[2] - a[2])^2) + t * ((c[1] - a[1])^2 + (c[2] - a[2])^2) - t * (1 - t) * ((c[1] - b[1])^2 + (c[2] - b[2])^2)
#     KB::definitions::distance_sq(a, d) = (1 - t) * KB::definitions::distance_sq(a, b) + t * KB::definitions::distance_sq(a, c) - t * (1 - t) * KB::definitions::distance_sq(b, c)

thm centroid_distance:
    ? forall a, b, c, g cart(R, R):
        g[1] = (a[1] + b[1] + c[1]) / 3,
        g[2] = (a[2] + b[2] + c[2]) / 3
        =>:
            KB::definitions::distance_sq(a, g) + KB::definitions::distance_sq(b, g) + KB::definitions::distance_sq(c, g) = (KB::definitions::distance_sq(a, b) + KB::definitions::distance_sq(b, c) + KB::definitions::distance_sq(a, c)) / 3
    KB::definitions::distance_sq(a, g) = (g[1] - a[1])^2 + (g[2] - a[2])^2
    KB::definitions::distance_sq(b, g) = (g[1] - b[1])^2 + (g[2] - b[2])^2
    KB::definitions::distance_sq(c, g) = (g[1] - c[1])^2 + (g[2] - c[2])^2
    KB::definitions::distance_sq(a, b) = (b[1] - a[1])^2 + (b[2] - a[2])^2
    KB::definitions::distance_sq(b, c) = (c[1] - b[1])^2 + (c[2] - b[2])^2
    KB::definitions::distance_sq(a, c) = (c[1] - a[1])^2 + (c[2] - a[2])^2
    (g[1] - a[1])^2 + (g[2] - a[2])^2 + ((g[1] - b[1])^2 + (g[2] - b[2])^2) + ((g[1] - c[1])^2 + (g[2] - c[2])^2) = (((a[1] + b[1] + c[1]) / 3 - a[1])^2 + ((a[2] + b[2] + c[2]) / 3 - a[2])^2) + (((a[1] + b[1] + c[1]) / 3 - b[1])^2 + ((a[2] + b[2] + c[2]) / 3 - b[2])^2) + (((a[1] + b[1] + c[1]) / 3 - c[1])^2 + ((a[2] + b[2] + c[2]) / 3 - c[2])^2)
    (((a[1] + b[1] + c[1]) / 3 - a[1])^2 + ((a[2] + b[2] + c[2]) / 3 - a[2])^2) + (((a[1] + b[1] + c[1]) / 3 - b[1])^2 + ((a[2] + b[2] + c[2]) / 3 - b[2])^2) + (((a[1] + b[1] + c[1]) / 3 - c[1])^2 + ((a[2] + b[2] + c[2]) / 3 - c[2])^2) = ((b[1] - a[1])^2 + (b[2] - a[2])^2 + ((c[1] - b[1])^2 + (c[2] - b[2])^2) + ((c[1] - a[1])^2 + (c[2] - a[2])^2)) / 3
    KB::definitions::distance_sq(a, g) + KB::definitions::distance_sq(b, g) + KB::definitions::distance_sq(c, g) = (g[1] - a[1])^2 + (g[2] - a[2])^2 + ((g[1] - b[1])^2 + (g[2] - b[2])^2) + ((g[1] - c[1])^2 + (g[2] - c[2])^2)
    (KB::definitions::distance_sq(a, b) + KB::definitions::distance_sq(b, c) + KB::definitions::distance_sq(a, c)) / 3 = ((b[1] - a[1])^2 + (b[2] - a[2])^2 + ((c[1] - b[1])^2 + (c[2] - b[2])^2) + ((c[1] - a[1])^2 + (c[2] - a[2])^2)) / 3
    KB::definitions::distance_sq(a, g) + KB::definitions::distance_sq(b, g) + KB::definitions::distance_sq(c, g) = (KB::definitions::distance_sq(a, b) + KB::definitions::distance_sq(b, c) + KB::definitions::distance_sq(a, c)) / 3

thm triangle_area_det:
    ? forall a, b, c cart(R, R):
        KB::definitions::det(KB::definitions::vec(a, b), KB::definitions::vec(a, c)) = (b[1] - a[1]) * (c[2] - a[2]) - (b[2] - a[2]) * (c[1] - a[1])
    KB::definitions::vec(a, b) = (b[1] - a[1], b[2] - a[2])
    KB::definitions::vec(a, c) = (c[1] - a[1], c[2] - a[2])
    KB::definitions::det(KB::definitions::vec(a, b), KB::definitions::vec(a, c)) = KB::definitions::vec(a, b)[1] * KB::definitions::vec(a, c)[2] - KB::definitions::vec(a, b)[2] * KB::definitions::vec(a, c)[1] = (b[1] - a[1]) * (c[2] - a[2]) - (b[2] - a[2]) * (c[1] - a[1])

