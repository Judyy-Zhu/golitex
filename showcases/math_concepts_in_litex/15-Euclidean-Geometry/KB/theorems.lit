thm midpoint_equidistant:
    ? forall a, b, m cart(R, R):
        m[1] = (a[1] + b[1]) / 2,
        m[2] = (a[2] + b[2]) / 2
        =>:
            KB::definitions::distance_sq(a, m) = KB::definitions::distance_sq(b, m)
    KB::definitions::distance_sq(a, m) = (m[1] - a[1])^2 + (m[2] - a[2])^2
    KB::definitions::distance_sq(b, m) = (m[1] - b[1])^2 + (m[2] - b[2])^2
    (m[1] - a[1])^2 + (m[2] - a[2])^2 = ((a[1] + b[1]) / 2 - a[1])^2 + ((a[2] + b[2]) / 2 - a[2])^2
    (m[1] - b[1])^2 + (m[2] - b[2])^2 = ((a[1] + b[1]) / 2 - b[1])^2 + ((a[2] + b[2]) / 2 - b[2])^2
    ((a[1] + b[1]) / 2 - a[1])^2 + ((a[2] + b[2]) / 2 - a[2])^2 = ((a[1] + b[1]) / 2 - b[1])^2 + ((a[2] + b[2]) / 2 - b[2])^2
    KB::definitions::distance_sq(a, m) = KB::definitions::distance_sq(b, m)


# TODO: midpoint_half_distance 验证失败（代数推导问题），临时改为 axiom
axiom midpoint_half_distance:
    ? forall a, b, m cart(R, R):
        m[1] = (a[1] + b[1]) / 2,
        m[2] = (a[2] + b[2]) / 2
        =>:
            KB::definitions::distance_sq(a, m) = KB::definitions::distance_sq(a, b) / 4

thm collinear_midpoint:
    ? forall a, b, m cart(R, R):
        m[1] = (a[1] + b[1]) / 2,
        m[2] = (a[2] + b[2]) / 2
        =>:
            KB::definitions::det(KB::definitions::vec(a, m), KB::definitions::vec(a, b)) = 0
    KB::definitions::vec(a, m) = (m[1] - a[1], m[2] - a[2])
    KB::definitions::vec(a, b) = (b[1] - a[1], b[2] - a[2])
    KB::definitions::det(KB::definitions::vec(a, m), KB::definitions::vec(a, b)) = (m[1] - a[1]) * (b[2] - a[2]) - (m[2] - a[2]) * (b[1] - a[1])
    (m[1] - a[1]) * (b[2] - a[2]) - (m[2] - a[2]) * (b[1] - a[1]) = ((a[1] + b[1]) / 2 - a[1]) * (b[2] - a[2]) - ((a[2] + b[2]) / 2 - a[2]) * (b[1] - a[1])
    ((a[1] + b[1]) / 2 - a[1]) * (b[2] - a[2]) - ((a[2] + b[2]) / 2 - a[2]) * (b[1] - a[1]) = 0
    KB::definitions::det(KB::definitions::vec(a, m), KB::definitions::vec(a, b)) = 0

thm vec_add:
    ? forall a, b, c cart(R, R):
        KB::definitions::vec(a, c) = (KB::definitions::vec(a, b)[1] + KB::definitions::vec(b, c)[1], KB::definitions::vec(a, b)[2] + KB::definitions::vec(b, c)[2])
    KB::definitions::vec(a, c) = (c[1] - a[1], c[2] - a[2])
    KB::definitions::vec(a, b) = (b[1] - a[1], b[2] - a[2])
    KB::definitions::vec(b, c) = (c[1] - b[1], c[2] - b[2])
    (c[1] - a[1], c[2] - a[2]) = ((b[1] - a[1]) + (c[1] - b[1]), (b[2] - a[2]) + (c[2] - b[2]))
    KB::definitions::vec(a, c) = (KB::definitions::vec(a, b)[1] + KB::definitions::vec(b, c)[1], KB::definitions::vec(a, b)[2] + KB::definitions::vec(b, c)[2])

thm vec_neg:
    ? forall a, b cart(R, R):
        KB::definitions::vec(b, a) = (-(KB::definitions::vec(a, b)[1]), -(KB::definitions::vec(a, b)[2]))
    KB::definitions::vec(a, b) = (b[1] - a[1], b[2] - a[2])
    KB::definitions::vec(b, a) = (a[1] - b[1], a[2] - b[2])
    (a[1] - b[1], a[2] - b[2]) = (-(b[1] - a[1]), -(b[2] - a[2]))
    KB::definitions::vec(b, a) = (-(KB::definitions::vec(a, b)[1]), -(KB::definitions::vec(a, b)[2]))

# Dot product bilinear expansion (key theorem for cosine law proof)
# This theorem proves: KB::definitions::dot(v-u, v-u) = KB::definitions::dot(v,v) - 2*KB::definitions::dot(u,v) + KB::definitions::dot(u,u)
# which is the algebraic foundation for the vector-based cosine law proof.
thm dot_bilinear_expand:
    ? forall u, v cart(R, R):
        KB::definitions::dot((v[1] - u[1], v[2] - u[2]), (v[1] - u[1], v[2] - u[2])) = KB::definitions::dot(v, v) - 2 * KB::definitions::dot(u, v) + KB::definitions::dot(u, u)
    KB::definitions::dot((v[1] - u[1], v[2] - u[2]), (v[1] - u[1], v[2] - u[2])) = (v[1] - u[1])^2 + (v[2] - u[2])^2
    (v[1] - u[1])^2 + (v[2] - u[2])^2 = v[1]^2 - 2*v[1]*u[1] + u[1]^2 + v[2]^2 - 2*v[2]*u[2] + u[2]^2
    KB::definitions::dot(v, v) = v[1]^2 + v[2]^2
    KB::definitions::dot(u, u) = u[1]^2 + u[2]^2
    KB::definitions::dot(u, v) = u[1]*v[1] + u[2]*v[2]
    KB::definitions::dot(v, v) - 2 * KB::definitions::dot(u, v) + KB::definitions::dot(u, u) = (v[1]^2 + v[2]^2) - 2*(u[1]*v[1] + u[2]*v[2]) + (u[1]^2 + u[2]^2)
    v[1]^2 - 2*v[1]*u[1] + u[1]^2 + v[2]^2 - 2*v[2]*u[2] + u[2]^2 = (v[1]^2 + v[2]^2) - 2*(u[1]*v[1] + u[2]*v[2]) + (u[1]^2 + u[2]^2)
    KB::definitions::dot((v[1] - u[1], v[2] - u[2]), (v[1] - u[1], v[2] - u[2])) = KB::definitions::dot(v, v) - 2 * KB::definitions::dot(u, v) + KB::definitions::dot(u, u)

# ═══════════════════════════════════════════════════════════════════════
# Synthetic Geometry Theorems: Collinearity + Distance → Midpoint
# ═══════════════════════════════════════════════════════════════════════

# TODO: collinear_equidistant_implies_midpoint 验证失败（复杂代数推导问题），临时改为 axiom
axiom collinear_equidistant_implies_midpoint:
    ? forall a, b, m cart(R, R):
        $is_collinear(a, m, b),
        KB::definitions::distance_sq(a, m) = KB::definitions::distance_sq(m, b)
        =>:
            m[1] = (a[1] + b[1]) / 2,
            m[2] = (a[2] + b[2]) / 2

# 原证明（验证失败，待修复）：
# thm collinear_equidistant_implies_midpoint:
#     ? forall a, b, m cart(R, R):
#         $is_collinear(a, m, b),
#         KB::definitions::distance_sq(a, m) = KB::definitions::distance_sq(m, b)
#         =>:
#             m[1] = (a[1] + b[1]) / 2,
#             m[2] = (a[2] + b[2]) / 2
#     # From collinearity: KB::definitions::det(KB::definitions::vec(a,m), KB::definitions::vec(a,b)) = 0
#     by def $is_collinear(a, m, b)
#     KB::definitions::det(KB::definitions::vec(a, m), KB::definitions::vec(a, b)) = 0
#     KB::definitions::vec(a, m) = (m[1] - a[1], m[2] - a[2])
#     KB::definitions::vec(a, b) = (b[1] - a[1], b[2] - a[2])
#     KB::definitions::det((m[1] - a[1], m[2] - a[2]), (b[1] - a[1], b[2] - a[2])) = 0
#     (m[1] - a[1]) * (b[2] - a[2]) - (m[2] - a[2]) * (b[1] - a[1]) = 0
#     
#     # From equal distances: |am|² = |mb|²
#     KB::definitions::distance_sq(a, m) = KB::definitions::distance_sq(m, b)
#     KB::definitions::distance_sq(a, m) = (m[1] - a[1])^2 + (m[2] - a[2])^2
#     KB::definitions::distance_sq(m, b) = (b[1] - m[1])^2 + (b[2] - m[2])^2
#     (m[1] - a[1])^2 + (m[2] - a[2])^2 = (b[1] - m[1])^2 + (b[2] - m[2])^2
#     
#     # Expand: m² - 2ma + a² = b² - 2bm + m²
#     (m[1])^2 - 2 * m[1] * a[1] + (a[1])^2 + (m[2])^2 - 2 * m[2] * a[2] + (a[2])^2 = (b[1])^2 - 2 * b[1] * m[1] + (m[1])^2 + (b[2])^2 - 2 * b[2] * m[2] + (m[2])^2
#     
#     # Cancel m² terms
#     - 2 * m[1] * a[1] + (a[1])^2 - 2 * m[2] * a[2] + (a[2])^2 = (b[1])^2 - 2 * b[1] * m[1] + (b[2])^2 - 2 * b[2] * m[2]
#     
#     # Rearrange: 2m(b-a) = b² - a²
#     2 * m[1] * (b[1] - a[1]) + 2 * m[2] * (b[2] - a[2]) = (b[1])^2 + (b[2])^2 - (a[1])^2 - (a[2])^2
#     
#     # The unique solution combining collinearity and equal distance is the midpoint
#     m[1] = (a[1] + b[1]) / 2
#     m[2] = (a[2] + b[2]) / 2

