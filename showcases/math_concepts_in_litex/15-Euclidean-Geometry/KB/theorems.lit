axiom parallelogram_diagonals:
    ? forall a, b, c, d cart(R, R):
        d[1] = a[1] + c[1] - b[1],
        d[2] = a[2] + c[2] - b[2]
        =>:
            KB::definitions::distance_sq(a, c) + KB::definitions::distance_sq(b, d) = 2 * KB::definitions::distance_sq(a, b) + 2 * KB::definitions::distance_sq(b, c)

