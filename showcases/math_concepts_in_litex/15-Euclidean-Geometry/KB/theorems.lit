# TODO: perp_dot_zero_coordinate 验证失败（需要多项式约简），临时改为 axiom
axiom perp_dot_zero_coordinate:
    ? forall a, b, c, d cart(R, R):
        (b[1] - a[1]) * (d[1] - c[1]) + (b[2] - a[2]) * (d[2] - c[2]) = 0
        =>:
            (b[1] - a[1]) * (d[1] - c[1]) = -(b[2] - a[2]) * (d[2] - c[2])

# 原证明（验证失败，待修复）：
# thm perp_dot_zero_coordinate:
#     ? forall a, b, c, d cart(R, R):
#         (b[1] - a[1]) * (d[1] - c[1]) + (b[2] - a[2]) * (d[2] - c[2]) = 0
#         =>:
#             (b[1] - a[1]) * (d[1] - c[1]) = -(b[2] - a[2]) * (d[2] - c[2])
#     (b[1] - a[1]) * (d[1] - c[1]) = -(b[2] - a[2]) * (d[2] - c[2])

# Pythagorean: right angle at P => |PA|^2 + |PB|^2 = |AB|^2
thm perpendicular_implies_distance_sum:
    ? forall a, b, p cart(R, R):
        (a[1] - p[1]) * (b[1] - p[1]) + (a[2] - p[2]) * (b[2] - p[2]) = 0
        =>:
            (p[1] - a[1])^2 + (p[2] - a[2])^2 + (p[1] - b[1])^2 + (p[2] - b[2])^2 = (b[1] - a[1])^2 + (b[2] - a[2])^2
    (p[1] - a[1])^2 + (p[2] - a[2])^2 + (p[1] - b[1])^2 + (p[2] - b[2])^2 = (b[1] - a[1])^2 + (b[2] - a[2])^2

# TODO: wu_circle_quartic 验证失败（需要多项式约简），临时改为 axiom
axiom wu_circle_quartic:
    ? forall p cart(R, R):
        p[1]^2 + p[2]^2 - 1 = 0
        =>:
            p[1]^4 + 2 * p[1]^2 * p[2]^2 + p[2]^4 - 1 = 0

