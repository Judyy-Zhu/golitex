        u[2] - v[2] = k * (p[2] - q[2]),
        w[1] - v[1] = k * (r[1] - q[1]),
        w[2] - v[2] = k * (r[2] - q[2])
        =>:
            KB::definitions::dot(KB::definitions::vec(v, u), KB::definitions::vec(v, w)) = k^2 * KB::definitions::dot(KB::definitions::vec(q, p), KB::definitions::vec(q, r))

