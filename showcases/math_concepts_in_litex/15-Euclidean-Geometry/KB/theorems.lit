thm apollonius_theorem:
    ? forall a, b, c, m cart(R, R):
        m[1] = (b[1] + c[1]) / 2,
        m[2] = (b[2] + c[2]) / 2
        =>:
            4 * KB::definitions::distance_sq(a, m) = 2 * KB::definitions::distance_sq(a, b) + 2 * KB::definitions::distance_sq(a, c) - KB::definitions::distance_sq(b, c)
    KB::definitions::distance_sq(a, m) = (m[1] - a[1])^2 + (m[2] - a[2])^2
    KB::definitions::distance_sq(a, b) = (b[1] - a[1])^2 + (b[2] - a[2])^2
    KB::definitions::distance_sq(a, c) = (c[1] - a[1])^2 + (c[2] - a[2])^2
    KB::definitions::distance_sq(b, c) = (c[1] - b[1])^2 + (c[2] - b[2])^2
    (m[1] - a[1])^2 + (m[2] - a[2])^2 = ((b[1] + c[1]) / 2 - a[1])^2 + ((b[2] + c[2]) / 2 - a[2])^2
    4 * (((b[1] + c[1]) / 2 - a[1])^2 + ((b[2] + c[2]) / 2 - a[2])^2) = 2 * ((b[1] - a[1])^2 + (b[2] - a[2])^2) + 2 * ((c[1] - a[1])^2 + (c[2] - a[2])^2) - ((c[1] - b[1])^2 + (c[2] - b[2])^2)
    4 * KB::definitions::distance_sq(a, m) = 4 * (((b[1] + c[1]) / 2 - a[1])^2 + ((b[2] + c[2]) / 2 - a[2])^2)
    2 * ((b[1] - a[1])^2 + (b[2] - a[2])^2) + 2 * ((c[1] - a[1])^2 + (c[2] - a[2])^2) - ((c[1] - b[1])^2 + (c[2] - b[2])^2) = 2 * KB::definitions::distance_sq(a, b) + 2 * KB::definitions::distance_sq(a, c) - KB::definitions::distance_sq(b, c)
    4 * KB::definitions::distance_sq(a, m) = 2 * KB::definitions::distance_sq(a, b) + 2 * KB::definitions::distance_sq(a, c) - KB::definitions::distance_sq(b, c)

thm distance_sq_translate:
    ? forall a, b, t, a2, b2 cart(R, R):
        a2[1] = a[1] + t[1],
        a2[2] = a[2] + t[2],
        b2[1] = b[1] + t[1],
        b2[2] = b[2] + t[2]
        =>:
            KB::definitions::distance_sq(a2, b2) = KB::definitions::distance_sq(a, b)
    KB::definitions::distance_sq(a2, b2) = (b2[1] - a2[1])^2 + (b2[2] - a2[2])^2
    KB::definitions::distance_sq(a, b) = (b[1] - a[1])^2 + (b[2] - a[2])^2
    (b2[1] - a2[1])^2 + (b2[2] - a2[2])^2 = ((b[1] + t[1]) - (a[1] + t[1]))^2 + ((b[2] + t[2]) - (a[2] + t[2]))^2
    ((b[1] + t[1]) - (a[1] + t[1]))^2 + ((b[2] + t[2]) - (a[2] + t[2]))^2 = (b[1] - a[1])^2 + (b[2] - a[2])^2
    KB::definitions::distance_sq(a2, b2) = KB::definitions::distance_sq(a, b)

