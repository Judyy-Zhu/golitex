# TODO: angle_in_semicircle_coordinate 验证失败（需要多项式约简），临时改为 axiom
axiom angle_in_semicircle_coordinate:
    ? forall a, b, p cart(R, R):
        (p[1] - a[1]) * (p[1] - b[1]) + (p[2] - a[2]) * (p[2] - b[2]) = 0
        =>:
            (2 * p[1] - a[1] - b[1])^2 + (2 * p[2] - a[2] - b[2])^2 = (a[1] - b[1])^2 + (a[2] - b[2])^2

