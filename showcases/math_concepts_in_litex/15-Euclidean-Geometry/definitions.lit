# Analytic geometry primitives, written directly in coordinates so that
# Litex's arithmetic verifier can unfold them reliably.
have fn distance_sq(A, B cart(R, R)) R = (B[1] - A[1])^2 + (B[2] - A[2])^2
have fn perpendicular_dot(P, O, A, B cart(R, R)) R = (O[1] - P[1]) * (B[1] - A[1]) + (O[2] - P[2]) * (B[2] - A[2])
