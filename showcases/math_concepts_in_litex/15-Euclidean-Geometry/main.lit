have A cart(R, R) = (0, 0)
have B cart(R, R) = (4, 0)
have O cart(R, R) = (2, 0)
have P cart(R, R) = (2, 3)

$predicates::is_midpoint(O, A, B)
definitions::perpendicular_dot(P, O, A, B) = (O[1] - P[1]) * (B[1] - A[1]) + (O[2] - P[2]) * (B[2] - A[2])
(O[1] - P[1]) * (B[1] - A[1]) + (O[2] - P[2]) * (B[2] - A[2]) = 0
$predicates::is_perpendicular(P, O, A, B)
by thm theorems::perpendicular_bisector_equidistant(A, B, O, P) => definitions::distance_sq(P, A) = definitions::distance_sq(P, B)
definitions::distance_sq(P, A) = 13
definitions::distance_sq(P, B) = 13
