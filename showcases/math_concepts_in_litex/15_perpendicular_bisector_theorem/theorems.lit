thm mul_eq_right:
    ? forall x, y, z R:
        x = y
        =>:
            x * z = y * z
    x = y
    x * z = y * z

thm add_eq:
    ? forall x, y, u, v R:
        x = y
        u = v
        =>:
            x + u = y + v
    x = y
    u = v
    x + u = y + v

thm zero_difference_eq:
    ? forall x, y R:
        y - x = 0
        =>:
            x = y
    y - x = 0
    x = y

thm perpendicular_bisector_equidistant:
    ? forall A, B, O, P cart(R, R):
        $predicates::is_midpoint(O, A, B)
        $predicates::is_perpendicular(P, O, A, B)
        =>:
            definitions::distance_sq(P, A) = definitions::distance_sq(P, B)
    by def $predicates::is_midpoint(O, A, B)
    by def $predicates::is_perpendicular(P, O, A, B)
    definitions::perpendicular_dot(P, O, A, B) = (O[1] - P[1]) * (B[1] - A[1]) + (O[2] - P[2]) * (B[2] - A[2])
    (O[1] - P[1]) * (B[1] - A[1]) + (O[2] - P[2]) * (B[2] - A[2]) = 0
    definitions::distance_sq(P, A) = (A[1] - P[1])^2 + (A[2] - P[2])^2
    definitions::distance_sq(P, B) = (B[1] - P[1])^2 + (B[2] - P[2])^2
    A[1] + B[1] - 2 * P[1] = 2 * (O[1] - P[1])
    A[2] + B[2] - 2 * P[2] = 2 * (O[2] - P[2])
    (B[1] - P[1])^2 - (A[1] - P[1])^2 = (B[1] - A[1]) * (A[1] + B[1] - 2 * P[1])
    (B[2] - P[2])^2 - (A[2] - P[2])^2 = (B[2] - A[2]) * (A[2] + B[2] - 2 * P[2])
    by thm mul_eq_right(A[1] + B[1] - 2 * P[1], 2 * (O[1] - P[1]), B[1] - A[1]) => (A[1] + B[1] - 2 * P[1]) * (B[1] - A[1]) = 2 * (O[1] - P[1]) * (B[1] - A[1])
    (B[1] - A[1]) * (A[1] + B[1] - 2 * P[1]) = (A[1] + B[1] - 2 * P[1]) * (B[1] - A[1]) = 2 * (O[1] - P[1]) * (B[1] - A[1])
    by thm mul_eq_right(A[2] + B[2] - 2 * P[2], 2 * (O[2] - P[2]), B[2] - A[2]) => (A[2] + B[2] - 2 * P[2]) * (B[2] - A[2]) = 2 * (O[2] - P[2]) * (B[2] - A[2])
    (B[2] - A[2]) * (A[2] + B[2] - 2 * P[2]) = (A[2] + B[2] - 2 * P[2]) * (B[2] - A[2]) = 2 * (O[2] - P[2]) * (B[2] - A[2])
    by thm add_eq((B[1] - P[1])^2 - (A[1] - P[1])^2, 2 * (O[1] - P[1]) * (B[1] - A[1]), (B[2] - P[2])^2 - (A[2] - P[2])^2, 2 * (O[2] - P[2]) * (B[2] - A[2])) => ((B[1] - P[1])^2 - (A[1] - P[1])^2) + ((B[2] - P[2])^2 - (A[2] - P[2])^2) = 2 * (O[1] - P[1]) * (B[1] - A[1]) + 2 * (O[2] - P[2]) * (B[2] - A[2])
    2 * (O[1] - P[1]) * (B[1] - A[1]) + 2 * (O[2] - P[2]) * (B[2] - A[2]) = 2 * ((O[1] - P[1]) * (B[1] - A[1]) + (O[2] - P[2]) * (B[2] - A[2])) = 0
    ((B[1] - P[1])^2 + (B[2] - P[2])^2) - ((A[1] - P[1])^2 + (A[2] - P[2])^2) = ((B[1] - P[1])^2 - (A[1] - P[1])^2) + ((B[2] - P[2])^2 - (A[2] - P[2])^2) = 0
    by thm zero_difference_eq((A[1] - P[1])^2 + (A[2] - P[2])^2, (B[1] - P[1])^2 + (B[2] - P[2])^2)
    definitions::distance_sq(P, A) = (A[1] - P[1])^2 + (A[2] - P[2])^2 = (B[1] - P[1])^2 + (B[2] - P[2])^2 = definitions::distance_sq(P, B)
